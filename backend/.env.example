# RailMind AI Backend Configuration

# API Key for securing /api/* routes and /ws/alerts WebSocket endpoint.
# Must match VITE_RAILMIND_API_KEY in frontend/.env.example for dev/demo setups.
# For production, use a strong, randomly generated key and keep it secret.
# Change this to a real value in .env (not committed to version control).
RAILMIND_API_KEY=change-this-admin-api-key

# Optional Gemini reasoning. Leave blank to use deterministic rule-based reasoning.
# Keep this key on the backend only; never expose it as a VITE_ variable.
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-2.5-flash

# CORS origins (comma-separated list or JSON array)
# Allowed origins for frontend requests to this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pipeline working directory (optional; defaults to backend/data/pipeline_video_data)
# PIPELINE_WORK_ROOT=/path/to/pipeline/data
