# Base URL for backend HTTP API requests
# IMPORTANT: Must be the full backend URL including origin (e.g. http://localhost:8000/api)
# A relative path like /api will break video stream playback outside of Vite dev proxy.
# Restart Vite after changing env values.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_RAILMIND_API_KEY=change-this-admin-api-key

# WebSocket server base URL for live updates
VITE_WS_URL=ws://localhost:8000
