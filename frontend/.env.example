# Base URL for backend API requests (includes /api path)
# Should be the full backend URL with /api suffix, e.g. http://localhost:8000/api
# The resolveStreamUrl() function automatically strips /api to derive the backend
# origin for resolving relative paths like /processed/... for video streams.
# A relative path like /api will work in dev but may break video streams in production.
# Restart Vite after changing env values.
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket server base URL for live updates
VITE_WS_URL=ws://localhost:8000

# API key for authenticating requests to /api/* and /ws/alerts endpoints.
# Must match RAILMIND_API_KEY in backend/.env.example for dev/demo setups.
# Embedded into browser bundle, so only safe for local/dev demos.
# For production, use a backend-for-frontend proxy that attaches the key server-side.
# See SECURITY.md for more details.
VITE_RAILMIND_API_KEY=change-this-admin-api-key
